meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "password123"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.token: isDefined
}

script:post-response {
  if (res.body && res.body.data && res.body.data.token) {
    bru.setEnvVar("jwtToken", res.body.data.token);
  }
}
